---
import { brand, logoSvg } from '../data/brand';

interface Props {
  size?: 'md' | 'sm';
}
const { size = 'md' } = Astro.props;
---
<span
  class:list={['wordmark', size]}
  aria-label="Joan Corona"
  role="img"
  style={`--wordmark-font: '${brand.wordmarkFont}'; --wordmark-weight: ${brand.wordmarkWeight};`}
>
  {logoSvg && <span class="mark" aria-hidden="true" set:html={logoSvg} />}
  <span aria-hidden="true">{brand.wordmark}</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--wordmark-font), var(--font-sans);
    font-weight: var(--wordmark-weight);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-text);
  }
  .md {
    font-size: 1.4rem;
  }
  .sm {
    font-size: 1.15rem;
  }
  .mark {
    display: inline-flex;
    width: 1.3em;
    height: 1.3em;
    flex-shrink: 0;
  }
  .mark :global(svg) {
    width: 100%;
    height: 100%;
  }
  .mark :global(.peak) {
    fill: var(--color-logo-peak);
  }
</style>
