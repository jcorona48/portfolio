---
interface Props {
  size?: 'md' | 'sm';
}
const { size = 'md' } = Astro.props;
---
<span class:list={['wordmark', size]} aria-label="Joan Corona" role="img">
  <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
    <path
      d="M8 46V20l12 12L32 10l12 22 12-12v26Z"
      fill="currentColor"
      stroke="currentColor"
      stroke-width="3"
      stroke-linejoin="round"
    />
    <rect x="8" y="50" width="48" height="6" rx="2" fill="currentColor" />
    <path class="peak" d="M32 10 44 32 32 26 20 32Z" />
  </svg>
  <span aria-hidden="true">Joan Corona</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-text);
  }
  .md {
    font-size: 1.4rem;
  }
  .sm {
    font-size: 1.15rem;
  }
  .mark {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
  }
  .peak {
    fill: var(--color-logo-peak);
  }
</style>
